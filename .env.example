# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database ---------------------------------------------------------------
# Two URLs pointing at the same database, on purpose.
# DATABASE_URL — the application runtime. Supabase transaction pooler: port
# 6543, ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL — the Prisma CLI only (migrate, studio). Supabase session pooler:
# port 5432, no pgbouncer. The transaction pooler cannot run migrations — it
# doesn't guarantee the session-level operations they need (advisory locks,
# shadow database creation). It must also be present in the build environment:
# `prisma generate` loads prisma.config.ts, whose env() throws on a missing
# variable immediately rather than lazily, even though nothing at runtime reads
# this value.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth -------------------------------------------------------------------
# Signs session cookies. Generate your own: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# The site's canonical address. In production this is also the fallback for the
# host allowlist in lib/auth.ts.
BETTER_AUTH_URL="http://localhost:3000"

# --- Avatar storage (server-side only) --------------------------------------
# The service role key bypasses row-level security. It must never reach the
# browser — note the deliberate absence of a NEXT_PUBLIC_ prefix here.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Realtime (browser) -----------------------------------------------------
# NEXT_PUBLIC_ variables are baked into the bundle at build time, not read at
# runtime: add or change one after a deploy and you have to rebuild, or live
# delivery stays silently dead while the code is fine.
# Without these two the app works and only live delivery sleeps — but set both
# or neither: lib/supabase.ts builds its client at module load.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
